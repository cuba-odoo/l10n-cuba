<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wizard_fiscal_year_closing" model="ir.ui.view">
        <field name="name">l10n_cu.fiscal.year.closing.wizard.form</field>
        <field name="model">l10n_cu.fiscal.year.closing.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group string="Configuración del Cierre">
                    <group>
                        <field name="fiscal_year" placeholder="Ej: 2025"/>
                        <field name="closing_date"/>
                    </group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </group>
                <footer>
                    <button name="action_create_closing" string="Iniciar Cierre" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_add_accounts_wizard" model="ir.actions.act_window">
        <field name="name">Agregar Cuentas al Cierre</field>
        <field name="res_model">l10n_cu.add.accounts.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_closing_id': active_id}</field>
    </record>

    <record id="view_fiscal_year_closing_form" model="ir.ui.view">
        <field name="name">l10n_cu.fiscal.year.closing.form</field>
        <field name="model">l10n_cu.fiscal.year.closing</field>
        <field name="arch" type="xml">
            <form string="Cierre de Ejercicio Fiscal">
                <header>
                    <button name="action_load_suggested_accounts" string="Cargar Cuentas Sugeridas"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_calculate_balances" string="Calcular Saldos"
                            type="object"
                            invisible="state != 'draft'"/>
                    <button name="action_create_closing_entry" string="Crear Asiento de Cierre"
                            type="object" class="btn-success"
                            invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancelar Cierre"
                            type="object" class="btn-danger"
                            invisible="state != 'posted'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>

                    <group>
                        <group>
                            <field name="fiscal_year"/>
                            <field name="closing_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="total_accounts"/>
                            <field name="selected_accounts"/>
                            <field name="total_income" widget="monetary"/>
                            <field name="total_expense" widget="monetary"/>
                            <field name="net_result" widget="monetary"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Cuentas para el Cierre" name="accounts">
                            <div class="mb-2">
                                <button name="action_load_suggested_accounts" string="Cargar Cuentas Sugeridas"
                                        type="object" class="btn btn-primary btn-sm"/>
                                <button name="l10n_cu_fiscal_year_closing.action_add_accounts_wizard"
                                        string="Agregar Cuentas" type="action" class="btn btn-secondary btn-sm"/>
                                <button name="action_calculate_balances" string="Calcular Saldos"
                                        type="object" class="btn btn-secondary btn-sm"/>
                            </div>

                            <div class="alert alert-info" role="status" invisible="total_accounts > 0">
                                No hay cuentas. Use "Cargar Cuentas Sugeridas" o "Agregar Cuentas".
                            </div>

                            <field name="account_ids" nolabel="1">
                                <list editable="bottom" create="false">
                                    <field name="include_in_closing" widget="boolean_toggle" string="Incluir"/>
                                    <field name="account_code" readonly="1" string="Código"/>
                                    <field name="account_name" readonly="1" string="Nombre"/>
                                    <field name="account_type" readonly="1" string="Tipo"/>
                                    <field name="balance" widget="monetary" readonly="1" sum="Total"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>

                <chatter />
            </form>
        </field>
    </record>

    <record id="view_fiscal_year_closing_list" model="ir.ui.view">
        <field name="name">l10n_cu.fiscal.year.closing.list</field>
        <field name="model">l10n_cu.fiscal.year.closing</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="fiscal_year"/>
                <field name="closing_date"/>
                <field name="total_income" sum="Total Ingresos"/>
                <field name="total_expense" sum="Total Gastos"/>
                <field name="net_result" sum="Resultado Neto" decoration-success="net_result &gt; 0" decoration-danger="net_result &lt; 0"/>
                <field name="state" widget="badge" decoration-success="state == 'posted'" decoration-warning="state == 'draft'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_wizard_fiscal_year_closing" model="ir.actions.act_window">
        <field name="name">Nuevo Cierre de Ejercicio</field>
        <field name="res_model">l10n_cu.fiscal.year.closing.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_fiscal_year_closing" model="ir.actions.act_window">
        <field name="name">Historial de Cierres</field>
        <field name="res_model">l10n_cu.fiscal.year.closing</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_fiscal_year_closing_wizard"
              name="Cierre de Ejercicio Fiscal"
              parent="account.menu_finance_configuration"
              action="action_wizard_fiscal_year_closing"
              sequence="99"
              groups="account.group_account_manager"/>

    <menuitem id="menu_fiscal_year_closing_history"
              name="Historial de Cierres"
              parent="account.menu_finance_configuration"
              action="action_fiscal_year_closing"
              sequence="100"
              groups="account.group_account_manager"/>
</odoo>
