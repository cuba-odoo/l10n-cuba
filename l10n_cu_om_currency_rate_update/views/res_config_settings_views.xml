<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form_rate_update_cuba" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.rate.update.cuba</field>
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="om_currency_rate_update.res_config_settings_view_form_rate_update"
        />
        <field name="arch" type="xml">
            <xpath
                expr="//div[@id='om_update_exchange_rates']//field[@name='rate_fallback_provider']/.."
                position="after"
            >
                <!-- Tasa BCC: visible si rate_provider O rate_fallback_provider es 'bcc' -->
                <div
                    class="row"
                    attrs="{'invisible': [('rate_provider', '!=', 'bcc'), ('rate_fallback_provider', '!=', 'bcc')]}"
                >
                    <label
                        for="rate_bcc_tasa"
                        string="Tasa BCC"
                        class="col-lg-4 o_light_label"
                    />
                    <field name="rate_bcc_tasa" required="1" />
                </div>

                <!-- Token El Toque: visible si rate_provider O rate_fallback_provider es 'eltoque' -->
                <div
                    class="row"
                    groups="base.group_system"
                    attrs="{'invisible': [('rate_provider', '!=', 'eltoque'), ('rate_fallback_provider', '!=', 'eltoque')]}"
                >
                    <label
                        for="rate_eltoque_token"
                        string="Token El Toque"
                        class="col-lg-4 o_light_label"
                    />
                    <field name="rate_eltoque_token" password="True" />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
