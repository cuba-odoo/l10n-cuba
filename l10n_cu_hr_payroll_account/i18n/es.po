#. module: l10n_cu_hr_payroll_account
#: model:ir.model,name:l10n_cu_hr_payroll_account.model_hr_payslip_employees
msgid "Generate payslips for all selected employees"
msgstr "Generar las nóminas para todos los empleados seleccionados"

#. module: l10n_cu_hr_payroll_account
#: model:ir.model.fields,field_description:l10n_cu_hr_payroll_account.field_hr_payslip_employees__struct_id
msgid "Salary Structure"
msgstr "Estructura salarial"

#. module: l10n_cu_hr_payroll_account
#: model:ir.model.fields,help:l10n_cu_hr_payroll_account.field_hr_payslip_employees__struct_id
msgid ""
"To compute a payslip by worked days, select the operational or "
"administrative structure."
msgstr ""
"Si desea realizar una nómina por días trabajados, seleccione la estructura "
"operativa o administrativa."

#. module: l10n_cu_hr_payroll_account
#. odoo-python
#: code:addons/l10n_cu_hr_payroll_account/wizard/hr_payroll_payslips_by_employees.py:0
msgid "You must select employee(s) to generate payslip(s)."
msgstr "Debe seleccionar un trabajador para generar la nómina."

#. module: l10n_cu_hr_payroll_account
#. odoo-python
#: code:addons/l10n_cu_hr_payroll_account/wizard/hr_payroll_payslips_by_employees.py:0
msgid "Generate the payslips from a payslip batch."
msgstr "Genere las nóminas desde un lote de nóminas."

#. module: l10n_cu_hr_payroll_account
#. odoo-python
#: code:addons/l10n_cu_hr_payroll_account/wizard/hr_payroll_payslips_by_employees.py:0
msgid ""
"The employee %(employee)s has no contract with the selected salary "
"structure."
msgstr ""
"El empleado %(employee)s no tiene ningún contrato con la estructura salarial "
"seleccionada."
