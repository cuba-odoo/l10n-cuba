<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Denominations not in circulation in Cuba. Search by value so the
         deletion stays idempotent on every module update. -->
    <delete model="pos.bill" search="[('value', 'in', [0.25, 0.5, 2.0])]"/>

    <data noupdate="1">
        <record model="pos.bill" id="3_00">
            <field name="name">3.00</field>
            <field name="value">3.00</field>
        </record>
        <record model="pos.bill" id="500_00">
            <field name="name">500.00</field>
            <field name="value">500.00</field>
        </record>
        <record model="pos.bill" id="1000_00">
            <field name="name">1000.00</field>
            <field name="value">1000.00</field>
        </record>
        <record model="pos.bill" id="2000_00">
            <field name="name">2000.00</field>
            <field name="value">2000.00</field>
        </record>
        <record model="pos.bill" id="5000_00">
            <field name="name">5000.00</field>
            <field name="value">5000.00</field>
        </record>
    </data>
</odoo>
