<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form_cu_reports_multi" model="ir.ui.view">
        <field name="name">res.config.settings.form.cu.reports.multi</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='reload_template']" position="after">
                <button
                    name="action_refresh_all_financial_reports"
                    string="Recargar cuentas de los estados financieros cubanos"
                    help="Recargar cuentas de los estados financieros cubanos"
                    type="object"
                    class="btn-secondary ps-2 my-2 w-100"
                    icon="fa-refresh"
                />
            </xpath>
        </field>
    </record>
</odoo>
